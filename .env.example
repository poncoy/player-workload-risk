# Copiar a .env y completar con valores reales. .env NUNCA se commitea.

# API key gratuita de https://www.football-data.org/client/register
# Si se deja vacio, extract_fixtures.py usa el fixture mock incluido en data/sample/
FOOTBALL_DATA_API_KEY=

# Codigo de competicion en football-data.org para el Brasileirao Serie A
FOOTBALL_DATA_COMPETITION=BSA

# Temporada a consultar (anio de inicio)
FOOTBALL_DATA_SEASON=2026

# URL de la pagina de fixtures de CD Moquegua a scrapear (Transfermarkt)
MOQUEGUA_FIXTURES_URL=https://www.transfermarkt.com/cd-moquegua-fbc/spielplandatum/verein/40806

# Rutas (opcional, por defecto usan la estructura del repo)
DATA_RAW_DIR=data/raw
DATA_MAPPING_DIR=data/mapping
DATA_PROCESSED_DIR=data/processed
DUCKDB_PATH=data/processed/workload_risk.duckdb
